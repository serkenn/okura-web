# terraform.tfvars に写して書き換える（terraform.tfvars は git に入らない）。
# 秘密は書かない：API トークンは CLOUDFLARE_API_TOKEN、GitHub の Client secret は TF_VAR_github_client_secret で渡す。

zone     = "example.com"
hostname = "okura.example.com"

github_client_id = "Ov23xxxxxxxxxxxxxxxx"

# 開いてよい人（GitHub のアカウントの主のメールアドレス）
allowed_emails = [
  "you@example.com",
  "parent@example.com",
]

# GitHub の Organization で決めるとき（メールアドレスと「どちらか」で通る）
# github_organization = "example-family"
# github_teams        = ["okura"]

# コンテナを使わず、同じ PC で直接動かしているとき
# origin_service = "http://127.0.0.1:8765"
